# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) — or the legacy "anon" key under NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — or the legacy "service_role" key. Server only: NEVER prefix with
# NEXT_PUBLIC_, never commit it, never put it in the browser.
SUPABASE_SECRET_KEY=

# ---- App ----
APP_URL=https://your-domain.com             # used in password-reset links and payment callbacks
APP_JWT_SECRET=                             # long random string (openssl rand -hex 32); signs 1-day login tokens
CRON_SECRET=                                # long random string; protects /api/v1/cron/profit-update
# Leave empty: the browser calls this same app. Only set if the API is hosted elsewhere.
NEXT_PUBLIC_API_URL=

# ---- Email (pick ONE) ----
# Gmail app password:
MAIL_EMAIL=
MAIL_PASSWORD=
# or any SMTP server (takes priority if SMTP_HOST is set):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@your-domain.com
ADMIN_EMAIL=                                # receives "new withdrawal request" emails

# ---- NOWPayments (optional crypto deposits) ----
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Sandbox testing: NOWPAYMENTS_BASE_URL=https://api-sandbox.nowpayments.io/v1 (use the sandbox API key too)
# NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
# MIN_DEPOSIT_USD=10
# MAX_DEPOSIT_USD=100000
# NOWPAYMENTS_ALLOWED_CURRENCIES=usdttrc20,usdterc20

# ---- Maintenance banner (optional) ----
# NEXT_PUBLIC_MAINTENANCE_BANNER=on
# NEXT_PUBLIC_MAINTENANCE_MESSAGE=We are performing maintenance...
